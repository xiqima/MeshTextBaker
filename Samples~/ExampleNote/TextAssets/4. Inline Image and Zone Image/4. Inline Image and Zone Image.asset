  m_Name: 4. Inline Image and Zone Image
  m_EditorClassIdentifier: 
  key: 
  fallbackLocale: en
  richTextEnabled: 1
  markdownEnabled: 1
  translations:
  - locale: en
    text: 'If you want to insert an image, you can easily do so in two ways:

      -
      Using a separate Zone with the role Image.

      - Or directly in the text
      using the Inline tag `<image=my_image>`. Like this -> <image=smile h=11>'
